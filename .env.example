# === App ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# === App (browser-visible — used by apps/web) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # backend only — never expose
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=          # backend only — HS256 secret used to verify organizer JWTs

# === Stellar ===
STELLAR_NETWORK=testnet         # testnet | public
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_ISSUER_SECRET=          # SXX... testnet account funded by friendbot
REPUTATION_CONTRACT_ID=         # filled after Phase 1 deploy
PALUWAGAN_CONTRACT_ID=          # filled after Phase 1 deploy

# === Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886    # sandbox default
TWILIO_WEBHOOK_VALIDATION=true
WEBHOOK_PUBLIC_BASE_URL=https://api.damay.kenbuilds.tech  # base URL Twilio calls; used for signature verification. Required in prod (any reverse proxy rewrites the URL the app server sees); locally http://localhost:8000 is fine. When unset the router falls back to request.url and warns once.

# === Claude API ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# === Observability ===
SENTRY_DSN=
LOG_LEVEL=info

# === Security ===
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=

# === Feature flags ===
FEATURE_LATE_NIGHT_LEND=false   # v1.1 stub
FEATURE_REAL_PAYMENTS=false     # always false for hackathon demo
FEATURE_DEMO_MODE=true          # enables /dev/simulate-message
